{
  "name": "kinetix",
  "version": "1.0.0",
  "private": true,
  "description": "Kinetix \u2014 \u062f\u0641\u062a\u0631 \u062a\u0645\u0631\u06cc\u0646 \u06a9\u0644\u06cc\u0633\u062a\u0646\u06cc\u06a9\u0633 (Capacitor / Android)\u060c \u0622\u0641\u0644\u0627\u06cc\u0646 \u0648 \u062f\u0648\u200c\u0632\u0628\u0627\u0646\u0647",
  "scripts": {
    "locales": "node tools/build-locales.mjs",
    "add:android": "cap add android",
    "assets": "capacitor-assets generate --android",
    "patch": "node scripts/patch-android.mjs",
    "sync": "npm run locales && cap sync android && npm run patch",
    "setup": "npm install && (test -d android || cap add android) && npm run assets && npm run sync",
    "open": "cap open android",
    "apk": "cd android && ./gradlew assembleDebug",
    "aab": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/app": "latest",
    "@capacitor/core": "latest",
    "@capacitor/filesystem": "latest",
    "@capacitor/haptics": "latest",
    "@capacitor/local-notifications": "latest",
    "@capacitor/preferences": "latest",
    "@capacitor/share": "latest",
    "@capacitor/splash-screen": "latest",
    "@capacitor/status-bar": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "latest",
    "@capacitor/cli": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
